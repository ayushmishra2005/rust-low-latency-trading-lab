-- Daml Script tests for the settlement workflow. Run with: daml test

module SettlementTest where

import DA.Assert ((===))
import Daml.Script
import Settlement

data Fixture = Fixture
  with
    operator : Party
    alice : Party
    bob : Party

setup : Script Fixture
setup = do
  operator <- allocatePartyWithHint "operator" (PartyIdHint "operator")
  alice <- allocatePartyWithHint "alice" (PartyIdHint "alice")
  bob <- allocatePartyWithHint "bob" (PartyIdHint "bob")
  submit operator do createCmd Holding with operator, owner = alice, amount = 1000
  submit operator do createCmd Holding with operator, owner = bob, amount = 1000
  pure Fixture with operator, alice, bob

holdingAmount : Party -> Party -> Script Int
holdingAmount operator owner = do
  result <- queryContractKey @Holding operator (operator, owner)
  case result of
    Some (_, holding) -> pure holding.amount
    None -> abort "missing holding"

propose : Fixture -> Text -> [Leg] -> Script (ContractId SettlementInstruction)
propose fixture settlementId legs =
  submit fixture.operator do
    createCmd SettlementInstruction with
      operator = fixture.operator
      settlementId
      legs
      accepted = []

acceptAll : Fixture -> ContractId SettlementInstruction -> [Party] -> Script (ContractId SettlementInstruction)
acceptAll _ instruction [] = pure instruction
acceptAll fixture instruction (party :: rest) = do
  next <- submit party do exerciseCmd instruction Accept with party
  acceptAll fixture next rest

-- | Settles by declaring the legs the caller believes it is applying.
settle : Fixture -> ContractId SettlementInstruction -> [Leg] -> Script (ContractId SettlementReceipt)
settle fixture instruction expectedLegs =
  submit fixture.operator do
    exerciseCmd instruction Settle with expectedLegs, expectedLegCount = length expectedLegs

settleMustFail : Fixture -> ContractId SettlementInstruction -> [Leg] -> Script ()
settleMustFail fixture instruction expectedLegs =
  submitMustFail fixture.operator do
    exerciseCmd instruction Settle with expectedLegs, expectedLegCount = length expectedLegs

testSettlementMovesHoldingsAndConservesValue : Script ()
testSettlementMovesHoldingsAndConservesValue = do
  fixture <- setup
  let legs = [Leg with payer = fixture.alice, payee = fixture.bob, amount = 250]
  instruction <- propose fixture "stl_1" legs
  ready <- acceptAll fixture instruction [fixture.alice, fixture.bob]
  _ <- settle fixture ready legs

  aliceAmount <- holdingAmount fixture.operator fixture.alice
  bobAmount <- holdingAmount fixture.operator fixture.bob
  aliceAmount === 750
  bobAmount === 1250
  (aliceAmount + bobAmount) === 2000

testSettlementNeedsEveryParty : Script ()
testSettlementNeedsEveryParty = do
  fixture <- setup
  let legs = [Leg with payer = fixture.alice, payee = fixture.bob, amount = 100]
  instruction <- propose fixture "stl_2" legs
  partial <- acceptAll fixture instruction [fixture.alice]
  settleMustFail fixture partial legs

  aliceAmount <- holdingAmount fixture.operator fixture.alice
  aliceAmount === 1000

testDuplicateSettlementIdentityFails : Script ()
testDuplicateSettlementIdentityFails = do
  fixture <- setup
  let legs = [Leg with payer = fixture.alice, payee = fixture.bob, amount = 100]
  first <- propose fixture "stl_3" legs
  ready <- acceptAll fixture first [fixture.alice, fixture.bob]
  _ <- settle fixture ready legs

  -- The same identity cannot produce a second receipt.
  second <- propose fixture "stl_3" legs
  readySecond <- acceptAll fixture second [fixture.alice, fixture.bob]
  settleMustFail fixture readySecond legs

  aliceAmount <- holdingAmount fixture.operator fixture.alice
  aliceAmount === 900

testInsufficientHoldingFails : Script ()
testInsufficientHoldingFails = do
  fixture <- setup
  let legs = [Leg with payer = fixture.alice, payee = fixture.bob, amount = 5000]
  instruction <- propose fixture "stl_4" legs
  ready <- acceptAll fixture instruction [fixture.alice, fixture.bob]
  settleMustFail fixture ready legs

  aliceAmount <- holdingAmount fixture.operator fixture.alice
  aliceAmount === 1000

testBatchWithSeveralLegsIsAtomic : Script ()
testBatchWithSeveralLegsIsAtomic = do
  fixture <- setup
  let legs =
        [ Leg with payer = fixture.alice, payee = fixture.bob, amount = 300
        , Leg with payer = fixture.bob, payee = fixture.alice, amount = 100
        ]
  instruction <- propose fixture "stl_5" legs
  ready <- acceptAll fixture instruction [fixture.alice, fixture.bob]
  _ <- settle fixture ready legs

  aliceAmount <- holdingAmount fixture.operator fixture.alice
  bobAmount <- holdingAmount fixture.operator fixture.bob
  aliceAmount === 800
  bobAmount === 1200

testReceiptRecordsTheSettledEconomics : Script ()
testReceiptRecordsTheSettledEconomics = do
  fixture <- setup
  let legs = [Leg with payer = fixture.bob, payee = fixture.alice, amount = 10]
  instruction <- propose fixture "stl_6" legs
  ready <- acceptAll fixture instruction [fixture.alice, fixture.bob]
  receipt <- settle fixture ready legs

  Some stored <- queryContractId fixture.operator receipt
  stored.settlementId === "stl_6"
  stored.legs === legs
  stored.legCount === 1
  stored.economics === canonicalEconomics "stl_6" legs

testChangedAmountIsRefused : Script ()
testChangedAmountIsRefused = do
  fixture <- setup
  let legs = [Leg with payer = fixture.alice, payee = fixture.bob, amount = 200]
  instruction <- propose fixture "stl_7" legs
  ready <- acceptAll fixture instruction [fixture.alice, fixture.bob]
  settleMustFail fixture ready [Leg with payer = fixture.alice, payee = fixture.bob, amount = 900]

  aliceAmount <- holdingAmount fixture.operator fixture.alice
  aliceAmount === 1000

testChangedParticipantIsRefused : Script ()
testChangedParticipantIsRefused = do
  fixture <- setup
  carol <- allocatePartyWithHint "carol" (PartyIdHint "carol")
  submit fixture.operator do createCmd Holding with operator = fixture.operator, owner = carol, amount = 1000
  let legs = [Leg with payer = fixture.alice, payee = fixture.bob, amount = 200]
  instruction <- propose fixture "stl_8" legs
  ready <- acceptAll fixture instruction [fixture.alice, fixture.bob]

  -- A different payee under the same settlement identity is not settleable.
  settleMustFail fixture ready [Leg with payer = fixture.alice, payee = carol, amount = 200]
  -- Nor is a different payer.
  settleMustFail fixture ready [Leg with payer = carol, payee = fixture.bob, amount = 200]

  aliceAmount <- holdingAmount fixture.operator fixture.alice
  carolAmount <- holdingAmount fixture.operator carol
  aliceAmount === 1000
  carolAmount === 1000

testExactDuplicateSettlementIsIdempotent : Script ()
testExactDuplicateSettlementIsIdempotent = do
  fixture <- setup
  let legs = [Leg with payer = fixture.alice, payee = fixture.bob, amount = 150]
  instruction <- propose fixture "stl_9" legs
  ready <- acceptAll fixture instruction [fixture.alice, fixture.bob]
  receipt <- settle fixture ready legs

  -- Resending the identical batch does not move holdings a second time.
  repeated <- propose fixture "stl_9" legs
  readyAgain <- acceptAll fixture repeated [fixture.alice, fixture.bob]
  settleMustFail fixture readyAgain legs

  Some stored <- queryContractKey @SettlementReceipt fixture.operator (fixture.operator, "stl_9")
  stored._1 === receipt
  aliceAmount <- holdingAmount fixture.operator fixture.alice
  bobAmount <- holdingAmount fixture.operator fixture.bob
  aliceAmount === 850
  bobAmount === 1150

testLegCountMustMatch : Script ()
testLegCountMustMatch = do
  fixture <- setup
  let legs =
        [ Leg with payer = fixture.alice, payee = fixture.bob, amount = 100
        , Leg with payer = fixture.bob, payee = fixture.alice, amount = 40
        ]
  instruction <- propose fixture "stl_10" legs
  ready <- acceptAll fixture instruction [fixture.alice, fixture.bob]
  submitMustFail fixture.operator do
    exerciseCmd ready Settle with expectedLegs = legs, expectedLegCount = 1

  aliceAmount <- holdingAmount fixture.operator fixture.alice
  aliceAmount === 1000
